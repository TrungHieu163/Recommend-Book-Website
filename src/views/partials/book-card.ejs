<%# Partial thẻ sách dùng chung (A sở hữu) - book-card.ejs %>
<% const currentBook = typeof book !== 'undefined' ? book : {}; %>
<div class="col">
  <div class="card h-100 shadow-sm book-card border-0">
    <div class="position-relative overflow-hidden text-center bg-light" style="height: 260px;">
      <img src="<%= currentBook.pathImage || '/images/no-cover.png' %>" 
           class="card-img-top h-100 w-auto object-fit-contain p-2" 
           alt="<%= currentBook.productName || 'Ảnh sách' %>"
           loading="lazy"
           onerror="this.src='/images/no-cover.png'">
      <span class="badge bg-secondary position-absolute top-0 start-0 m-2">
        <%= currentBook.productType || 'Sách' %>
      </span>
      <%# Nút yêu thích của C: gắn data-book-id %>
      <button class="btn btn-sm btn-light rounded-circle position-absolute top-0 end-0 m-2 shadow-sm btn-favorite" 
              data-book-id="<%= currentBook.id %>" 
              aria-label="Thêm vào yêu thích" 
              title="Yêu thích">
        <i class="bi bi-heart text-danger"></i>
      </button>
    </div>
    <div class="card-body d-flex flex-column">
      <h6 class="card-title fw-bold text-truncate mb-1" title="<%= currentBook.productName %>">
        <a href="/books/<%= currentBook.id %>" class="text-decoration-none text-dark">
          <%= currentBook.productName %>
        </a>
      </h6>
      <p class="card-subtitle text-muted small mb-2 text-truncate">
        <%= currentBook.author || 'Tác giả chưa cập nhật' %>
      </p>
      <p class="card-text text-secondary small flex-grow-1 line-clamp-3 mb-3">
        <%= currentBook.description || 'Chưa có mô tả cho cuốn sách này.' %>
      </p>
      <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
        <small class="text-muted"><%= currentBook.productId %></small>
        <a href="/books/<%= currentBook.id %>" class="btn btn-outline-primary btn-sm">Chi tiết</a>
      </div>
    </div>
  </div>
</div>
