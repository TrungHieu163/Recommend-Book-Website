<%# Trang Dashboard quản trị (Admin) %>
<div class="admin-dashboard pb-5">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
      <li class="breadcrumb-item active" aria-current="page">Bảng điều khiển</li>
    </ol>
  </nav>

  <!-- Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h3 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Bảng điều khiển Quản trị</h3>
      <p class="text-muted small mb-0">Tổng quan hệ thống BookWeb AI</p>
    </div>
    <div class="text-muted small">
      <i class="bi bi-clock me-1"></i>Cập nhật lúc: <span id="dashboardUpdateTime">—</span>
    </div>
  </div>

  <!-- Thẻ thống kê chính -->
  <div class="row g-4 mb-4">
    <!-- Tổng sách -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body d-flex align-items-center gap-3 p-4">
          <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; min-width: 56px;">
            <i class="bi bi-book-half fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Tổng sách</div>
            <div class="fs-3 fw-bold" id="statTotalBooks">
              <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tổng người dùng -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body d-flex align-items-center gap-3 p-4">
          <div class="rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; min-width: 56px;">
            <i class="bi bi-people-fill fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Người dùng</div>
            <div class="fs-3 fw-bold" id="statTotalUsers">
              <span class="spinner-border spinner-border-sm text-success" role="status"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Liên hệ mới -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body d-flex align-items-center gap-3 p-4">
          <div class="rounded-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; min-width: 56px;">
            <i class="bi bi-envelope-open-fill fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Liên hệ mới</div>
            <div class="fs-3 fw-bold" id="statNewContacts">
              <span class="spinner-border spinner-border-sm text-warning" role="status"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tổng yêu thích -->
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body d-flex align-items-center gap-3 p-4">
          <div class="rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; min-width: 56px;">
            <i class="bi bi-heart-fill fs-3"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Lượt yêu thích</div>
            <div class="fs-3 fw-bold" id="statTotalFavorites">
              <span class="spinner-border spinner-border-sm text-danger" role="status"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hàng 2: Shortcuts + Thống kê phụ -->
  <div class="row g-4">
    <!-- Shortcuts quản trị -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge text-warning me-2"></i>Truy cập nhanh</h5>
          <div class="row g-3">
            <div class="col-6">
              <a href="/admin/books" class="card border rounded-3 text-decoration-none h-100 hover-shadow">
                <div class="card-body text-center py-4">
                  <i class="bi bi-table fs-2 text-primary d-block mb-2"></i>
                  <span class="fw-semibold text-dark">Quản lý sách</span>
                  <div class="text-muted small mt-1">CRUD, Import/Export</div>
                </div>
              </a>
            </div>
            <div class="col-6">
              <a href="/admin/users" class="card border rounded-3 text-decoration-none h-100 hover-shadow">
                <div class="card-body text-center py-4">
                  <i class="bi bi-people fs-2 text-success d-block mb-2"></i>
                  <span class="fw-semibold text-dark">Quản lý người dùng</span>
                  <div class="text-muted small mt-1">Tài khoản, Phân quyền</div>
                </div>
              </a>
            </div>
            <div class="col-6">
              <a href="/admin/contacts" class="card border rounded-3 text-decoration-none h-100 hover-shadow">
                <div class="card-body text-center py-4">
                  <i class="bi bi-chat-left-dots fs-2 text-warning d-block mb-2"></i>
                  <span class="fw-semibold text-dark">Quản lý liên hệ</span>
                  <div class="text-muted small mt-1">Tin nhắn, Phản hồi</div>
                </div>
              </a>
            </div>
            <div class="col-6">
              <a href="/" class="card border rounded-3 text-decoration-none h-100 hover-shadow">
                <div class="card-body text-center py-4">
                  <i class="bi bi-compass fs-2 text-info d-block mb-2"></i>
                  <span class="fw-semibold text-dark">Khám phá sách</span>
                  <div class="text-muted small mt-1">Xem trang công khai</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Thống kê phụ -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-line text-primary me-2"></i>Thống kê chi tiết</h5>
          <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted"><i class="bi bi-tags me-2 text-primary"></i>Số thể loại sách</span>
              <span class="badge bg-primary-subtle text-primary rounded-pill fs-6" id="statGenreCount">
                <span class="spinner-border spinner-border-sm" role="status"></span>
              </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted"><i class="bi bi-person-check me-2 text-success"></i>Admin</span>
              <span class="badge bg-success-subtle text-success rounded-pill fs-6" id="statAdminCount">
                <span class="spinner-border spinner-border-sm" role="status"></span>
              </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted"><i class="bi bi-envelope-check me-2 text-info"></i>Liên hệ đã phản hồi</span>
              <span class="badge bg-info-subtle text-info rounded-pill fs-6" id="statRepliedContacts">
                <span class="spinner-border spinner-border-sm" role="status"></span>
              </span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span class="text-muted"><i class="bi bi-link-45deg me-2 text-secondary"></i>Sách có link mua</span>
              <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-6" id="statBooksWithLinks">
                <span class="spinner-border spinner-border-sm" role="status"></span>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin.dashboard.js"></script>
