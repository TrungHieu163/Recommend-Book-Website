<div class="row justify-content-center py-5">
  <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
          <i class="bi bi-person-circle text-primary fs-1"></i>
          <h2 class="fw-bold fs-4 mt-2">Đăng nhập</h2>
          <p class="text-muted small">Chào mừng bạn quay trở lại với BookWeb AI</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <form action="/login" method="POST" id="loginForm" novalidate>
          <% if (typeof csrfToken !== 'undefined') { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <input type="hidden" name="next" value="<%= typeof nextUrl !== 'undefined' ? nextUrl : '/' %>">

          <div class="mb-3">
            <label for="email" class="form-label small fw-semibold">Email</label>
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
              <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required autofocus>
            </div>
            <div class="invalid-feedback small">Vui lòng nhập email hợp lệ.</div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label small fw-semibold">Mật khẩu</label>
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-lock text-muted"></i></span>
              <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
            </div>
            <div class="invalid-feedback small">Vui lòng nhập mật khẩu.</div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm" id="btnLogin">
            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
          </button>
        </form>

        <div class="text-center mt-4 pt-2 border-top">
          <p class="text-muted small mb-0">
            Chưa có tài khoản? <a href="/register" class="text-primary text-decoration-none fw-semibold">Đăng ký ngay</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
