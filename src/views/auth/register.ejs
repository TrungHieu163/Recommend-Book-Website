<div class="row justify-content-center py-4">
  <div class="col-12 col-sm-10 col-md-8 col-lg-6">
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body p-4 p-sm-5">
        <div class="text-center mb-4">
          <i class="bi bi-person-plus-fill text-primary fs-1"></i>
          <h2 class="fw-bold fs-4 mt-2">Đăng ký tài khoản</h2>
          <p class="text-muted small">Tạo tài khoản để lưu sách yêu thích và nhận đề xuất AI cá nhân hóa</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <form action="/register" method="POST" id="registerForm" novalidate>
          <% if (typeof csrfToken !== 'undefined') { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% } %>
          <input type="hidden" name="preferredGenres" id="preferredGenresInput" value="[]">

          <div class="mb-3">
            <label for="fullName" class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-person text-muted"></i></span>
              <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Nguyễn Văn A" required minlength="2" maxlength="100">
            </div>
            <div class="invalid-feedback small">Họ tên phải có ít nhất 2 ký tự.</div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-sm-7">
              <label for="email" class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-envelope text-muted"></i></span>
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
              </div>
              <div class="invalid-feedback small">Email không hợp lệ.</div>
            </div>
            <div class="col-sm-5">
              <label for="phone" class="form-label small fw-semibold">Số điện thoại</label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-telephone text-muted"></i></span>
                <input type="tel" class="form-control" id="phone" name="phone" placeholder="0912345678" maxlength="20">
              </div>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label for="password" class="form-label small fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-shield-lock text-muted"></i></span>
                <input type="password" class="form-control" id="password" name="password" placeholder="Tối thiểu 8 ký tự" required minlength="8">
              </div>
              <div class="form-text small text-muted">Cần có cả chữ cái và chữ số.</div>
            </div>
            <div class="col-sm-6">
              <label for="confirmPassword" class="form-label small fw-semibold">Xác nhận mật khẩu <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-shield-check text-muted"></i></span>
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Nhập lại mật khẩu" required minlength="8">
              </div>
              <div class="invalid-feedback small">Mật khẩu xác nhận không khớp.</div>
            </div>
          </div>

          <!-- Chọn thể loại yêu thích (Tối đa 5) -->
          <div class="mb-4">
            <label class="form-label small fw-semibold d-flex justify-content-between">
              <span>Thể loại sách yêu thích (tùy chọn)</span>
              <span class="text-muted" id="genreCount">Đã chọn: 0/5</span>
            </label>
            <div class="d-flex flex-wrap gap-2 p-2 border rounded bg-light" id="genreChipsContainer">
              <% if (typeof availableGenres !== 'undefined' && availableGenres.length > 0) { %>
                <% availableGenres.forEach(genre => { %>
                  <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill genre-chip" data-genre="<%= genre %>">
                    + <%= genre %>
                  </button>
                <% }) %>
              <% } else { %>
                <span class="text-muted small">Không có thể loại nào sẵn sàng.</span>
              <% } %>
            </div>
            <div class="form-text small text-muted">Giúp AI đề xuất sách phù hợp với sở thích của bạn ngay từ đầu.</div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm" id="btnRegister">
            <i class="bi bi-check-circle me-1"></i> Hoàn tất đăng ký
          </button>
        </form>

        <div class="text-center mt-4 pt-2 border-top">
          <p class="text-muted small mb-0">
            Đã có tài khoản? <a href="/login" class="text-primary text-decoration-none fw-semibold">Đăng nhập ngay</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/auth.js"></script>
