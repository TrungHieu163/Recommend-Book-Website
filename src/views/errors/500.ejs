<div class="row justify-content-center text-center py-5">
  <div class="col-md-6">
    <div class="display-1 fw-bold text-danger mb-3">
      <%= typeof statusCode !== 'undefined' ? statusCode : '500' %>
    </div>
    <h2 class="fw-bold mb-3">Đã xảy ra sự cố</h2>
    <p class="text-muted mb-4">
      <%= typeof message !== 'undefined' ? message : 'Máy chủ gặp sự cố không mong muốn trong khi xử lý yêu cầu của bạn.' %>
    </p>
    <div class="d-flex justify-content-center gap-2">
      <a href="javascript:location.reload()" class="btn btn-outline-secondary px-4">
        <i class="bi bi-arrow-clockwise me-2"></i>Thử lại
      </a>
      <a href="/" class="btn btn-primary px-4">
        <i class="bi bi-house-door me-2"></i>Về trang chủ
      </a>
    </div>
  </div>
</div>
