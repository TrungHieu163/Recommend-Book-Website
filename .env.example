# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=book_ai_store
DB_USER=book_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Search ---
SEARCH_PROVIDER=db
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=

# --- AI ---
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_EMBED_MODEL=
AI_EMBED_DIMENSIONS=768
AI_INTENT_STEP=false
AI_REASONS=false
OLLAMA_HOST=http://127.0.0.1:11434
AI_TIMEOUT_MS=20000

# --- Upload ---
UPLOAD_DIR=public/uploads/books
MAX_IMAGE_MB=2
MAX_IMPORT_ZIP_MB=50

# --- C: auth ---
SESSION_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
AUTO_SEED=false
